# Copy to .env and fill in when you're ready to switch from mock providers to real AI generation.

PORT=4000

# --- Access gate (per-purchase codes from the sleukchak.site store) ---
# Leave blank for local dev / testing — the app is then fully open, no code
# required. Set this to a long random string in production, and set the
# EXACT same value in the PHP store's config so codes generated there verify
# here. See php-store-integration/README.md for the PHP side.
ACCESS_SECRET=

# --- ABA PayWay (in-app checkout — pay, get an access code instantly) ---
# Unofficial/scrape-based integration — see the big comment at the top of
# src/lib/abaPayway.js before relying on this in production. In short: it
# scrapes ABA's public payment-link page for the KHQR data their own
# checkout JS uses, so it can break if ABA changes that page, and ABA has
# previously 403'd this kind of request from Hostinger's shared IPs (may or
# may not affect Render — untested against the real endpoint so far).
#
# Leave ABA_PAYMENT_URL blank to run in mock mode: the "Pay with ABA PayWay"
# panel still works end-to-end (fake QR, auto-"approved" after ~8s) so the
# whole purchase → access-code flow can be built/tested without real
# ABA credentials. Set ABA_PAYMENT_URL once you have a real PayWay payment
# link from the ABA merchant portal to go live; ABA_MOCK=false forces real
# mode even then (ABA_MOCK=true forces mock mode even with a URL set).
#
# Works with an "open amount" ABA payment link (the kind where a human
# visiting it directly would type in their own amount) — this app supplies
# the amount itself with every request (from ACCESS_PRICE_USD below), the
# same way a buyer-typed amount would flow through ABA's own checkout JS.
# That also means the price is controlled entirely by ACCESS_PRICE_USD —
# change it any time without touching the ABA link itself.
ABA_PAYMENT_URL=
ABA_CLIENT_ID=
ABA_MOCK=
# Override only if a live test shows ABA's real API host/paths differ from
# what this integration currently assumes (checked against a real payment
# link's page on 2026-08-28 — see the comment at the top of abaPayway.js).
ABA_API_BASE=
ABA_LIST_OPTIONS_URL=
ABA_CHECK_STATUS_URL=
# Price for one access code — this app only sells the one product, at
# whatever price you set here. Change it any time; no ABA-side change needed.
ACCESS_PRICE_USD=9
ACCESS_CURRENCY=USD

# --- Image ad generation provider ---
# Example: an image-generation API that supports image-to-image / product photography style transfer.
IMAGE_PROVIDER=mock            # mock | replicate | stability | custom
IMAGE_PROVIDER_API_KEY=

# --- Video ad generation provider ---
# Example: an image-to-video generation API.
VIDEO_PROVIDER=mock            # mock | runway | pika | custom
VIDEO_PROVIDER_API_KEY=

# --- Storage ---
# Where generated assets are written. Defaults to local disk under backend/storage.
STORAGE_DRIVER=local           # local | s3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
