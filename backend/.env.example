# Copy to .env and fill in when you're ready to switch from mock providers to real AI generation.

PORT=4000

# --- Access gate (per-purchase codes from the sleukchak.site store) ---
# Leave blank for local dev / testing — the app is then fully open, no code
# required. Set this to a long random string in production, and set the
# EXACT same value in the PHP store's config so codes generated there verify
# here. See php-store-integration/README.md for the PHP side.
ACCESS_SECRET=

# --- Admin panel (/admin on your deployed site) ---
# Manages the brand name/logo and the per-payment-method logos shown on the
# ABA PayWay receipt. Blank = the /admin page is fully disabled (401/503 on
# every admin request) — set this to a long random string to turn it on.
# This is separate from ACCESS_SECRET; buyers never see or need this one.
ADMIN_SECRET=

# --- ABA PayWay (in-app checkout — pay, get an access code instantly) ---
# Built to your exact ABA PayWay SOP — see the comment at the top of
# src/lib/abaPayway.js. Only one thing is needed to go live: your PayWay
# payment link. No API key / client_id to configure — that comes back from
# ABA's own response and is used as-is.
#
# Leave ABA_PAYMENT_URL blank to run in mock mode: the "Pay with ABA PayWay"
# panel still works end-to-end (fake QR, auto-"approved" after ~8s) so the
# whole purchase → access-code flow can be built/tested without touching
# ABA at all. Set ABA_PAYMENT_URL to go live; ABA_MOCK=false forces real
# mode even then (ABA_MOCK=true forces mock mode even with a URL set).
#
# Works with an "open amount" link (the kind where a person visiting it
# directly would type in their own amount) — this app supplies the amount
# itself with every request (from ACCESS_PRICE_USD below). That also means
# the price is controlled entirely by ACCESS_PRICE_USD — change it any time
# without touching the ABA link itself.
ABA_PAYMENT_URL=
ABA_MOCK=
# Price for one access code — this app only sells the one product, at
# whatever price you set here. Change it any time; no ABA-side change needed.
ACCESS_PRICE_USD=9
ACCESS_CURRENCY=USD
# Shown on the payment receipt header/title until you set a brand name in
# the /admin panel (which then always takes priority over this fallback).
ACCESS_BRAND_NAME=AI Ads Generator

# --- Image ad generation provider ---
# Example: an image-generation API that supports image-to-image / product photography style transfer.
IMAGE_PROVIDER=mock            # mock | replicate | stability | custom
IMAGE_PROVIDER_API_KEY=

# --- Video ad generation provider ---
# Example: an image-to-video generation API.
VIDEO_PROVIDER=mock            # mock | runway | pika | custom
VIDEO_PROVIDER_API_KEY=

# --- Storage ---
# Where generated assets are written. Defaults to local disk under backend/storage.
STORAGE_DRIVER=local           # local | s3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
